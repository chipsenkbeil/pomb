   "put": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Edit a time entry",
    "requestBody": {
     "required": [],
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {},
        "required": []
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Updated entry"
     }
    }
   }
  },
  "/api/timer/start": {
   "post": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Start a timer (replaces any active one)",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "mode": {
          "type": "string",
          "enum": [
           "pomodoro",
           "stopwatch",
           "short_break",
           "long_break"
          ]
         },
         "task_id": {
          "type": "string"
         }
        },
        "required": [
         "mode"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Timer status",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TimerStatus"
        }
       }
      }
     }
    }
   }
  },
  "/api/timer/status": {
   "get": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Current timer status",
    "responses": {
     "200": {
      "description": "Timer status",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TimerStatus"
        }
       }
      }
     }
    }
   }
  },
  "/api/timer/stop": {
   "post": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Stop the active timer",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "completed": {
          "type": "boolean",
          "description": "True = finished successfully; false = interrupted"
         },
         "reason": {
          "type": "string",
          "description": "Why stopped early"
         }
        },
        "required": [
         "completed"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "{discarded, minutes, completed}. Sessions under 20s are discarded."
     }
    }
   }
  },
  "/api/timer/retarget": {
   "post": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Re-point the running timer at another task",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
