 "components": {
  "securitySchemes": {
   "bearerAuth": {
    "type": "http",
    "scheme": "bearer",
    "bearerFormat": "cf_..."
   }
  },
  "schemas": {
   "ApiToken": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "prefix": {
      "type": "string",
      "example": "cf_"
     },
     "last4": {
      "type": "string"
     },
     "scopes": {
      "type": "array",
      "items": {
       "type": "string",
       "enum": [
        "read",
        "write"
       ]
      }
     },
     "created_at": {
      "type": "integer",
      "format": "int64"
     },
     "last_used_at": {
      "type": "integer",
      "format": "int64"
     },
     "expires_at": {
      "type": "integer",
      "format": "int64"
     }
    },
    "required": [
     "id",
     "name",
     "prefix",
     "last4",
     "scopes",
     "created_at"
    ]
   },
   "CreateTokenRequest": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
     },
     "scopes": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string",
       "enum": [
        "read",
        "write"
       ]
      }
     },
     "expires_in_days": {
      "type": "integer",
      "description": "Days until expiry. Omitted or <= 0 means no expiry."
     }
    },
    "required": [
     "name",
     "scopes"
    ]
   },
   "Task": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "column_id": {
      "type": "string"
     },
     "swimlane_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "size": {
      "type": "integer",
      "description": "Pomodoro size 1-4 (4 means '>3')"
     },
     "size_label": {
      "type": "string"
     },
     "color_hex": {
      "type": "string"
     },
     "position": {
      "type": "number"
     },
     "completed_at": {
      "type": "string"
     }
    },
    "required": []
   },
   "Column": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "board_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "position": {
      "type": "number"
     },
     "wip_limit": {
      "type": "integer"
     },
     "is_done": {
      "type": "boolean"
     }
    },
    "required": []
   },
   "Swimlane": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "board_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "position": {
      "type": "number"
     }
    },
    "required": []
   },
   "TimerStatus": {
