{
 "openapi": "3.1.0",
 "info": {
  "title": "ChipFlow API",
  "version": "1.0.0",
  "description": "JSON API for the ChipFlow self-hosted kanban + pomodoro app. Full agent guide at /agents.md. Errors are plain-text bodies with 4xx/5xx statuses (no envelope). Timestamps are Unix seconds (UTC). Durations truncate to whole minutes."
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "security": [
  {
   "bearerAuth": []
  }
 ],
 "paths": {
  "/agents.md": {
   "get": {
    "description": "Curated agent guide: auth, worked curl examples, error model.",
    "responses": {
     "200": {
      "description": "Markdown guide"
     }
    }
   }
  },
  "/agents/skill.md": {
   "get": {
    "description": "Agent Skills-format guide (installable).",
    "responses": {
     "200": {
      "description": "Markdown skill"
     }
    }
   }
  },
  "/.well-known/agents.json": {
   "get": {
    "description": "Static pointer to the discovery docs.",
    "responses": {
     "200": {
      "description": "Pointer doc"
     }
    }
   }
  },
  "/api/v1/openapi.json": {
   "get": {
    "description": "This machine-readable contract.",
    "responses": {
     "200": {
      "description": "OpenAPI 3.1 JSON"
     }
    }
   }
  },
  "/api/v1/auth/tokens": {
   "get": {
    "description": "List API tokens. Requires the browser session cookie; Bearer tokens are rejected.",
    "responses": {
     "200": {
      "description": "Token list (no secrets)",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/ApiToken"
         }
        }
       }
      }
     }
    }
   },
   "post": {
    "description": "Create an API token; the raw token is returned exactly once. Requires the browser session cookie.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CreateTokenRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Token view plus raw_token (shown once)"
     }
    }
   }
  },
  "/api/v1/auth/tokens/{id}": {
   "delete": {
    "description": "Revoke an API token. Requires the browser session cookie.",
    "parameters": [
     {
      "in": "path",
      "name": "id",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "{revoked: id}"
     }
    }
   }
  },
  "/api/tasks": {
   "get": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "List tasks",
    "responses": {
     "200": {
      "description": "Tasks",
      "content": {
       "application/json": {
        "schema": {
         "type": "array"
        }
       }
      }
     }
    }
   },
   "post": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Create a task",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "column_id": {
          "type": "string"
         },
         "swimlane_id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "size": {
          "type": "integer",
          "description": "Pomodoro size 1-4 (4 means '>3')"
         }
        },
        "required": [
         "column_id",
         "name"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Created task"
     }
    }
   }
  },
  "/api/tasks/{id}": {
   "parameters": [
    {
     "in": "path",
     "name": "id",
     "required": true,
     "schema": {
      "type": "string"
     }
    }
   ],
   "patch": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Update a task (name, size, color)",
    "requestBody": {
     "required": [],
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {},
        "required": []
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Updated task"
     }
    }
   },
   "delete": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Delete a task",
    "responses": {
     "200": {
      "description": "Deleted"
     }
    }
   }
  },
