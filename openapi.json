  "/api/time/manual": {
   "post": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Log time manually",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "task_id": {
          "type": "string"
         },
         "date": {
          "type": "string",
          "description": "YYYY-MM-DD"
         },
         "from": {
          "type": "string",
          "description": "HH:MM 24h"
         },
         "to": {
          "type": "string",
          "description": "HH:MM 24h"
         },
         "note": {
          "type": "string"
         }
        },
        "required": [
         "task_id",
         "date",
         "from",
         "to"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Created entry",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TimeEntry"
        }
       }
      }
     },
     "400": {
      "description": "Future time, or zero/negative duration"
     }
    }
   }
  },
  "/api/time/entries/{id}": {
   "parameters": [
    {
     "in": "path",
     "name": "id",
     "required": true,
     "schema": {
      "type": "string"
     }
    }
   ],
   "get": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Get one time entry",
    "responses": {
