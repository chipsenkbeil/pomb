     {
      "in": "query",
      "name": "from",
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "to",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "{days, total_minutes}"
     }
    }
   }
  },
  "/api/timer/statistics": {
   "get": {
    "security": [
     {
      "bearerAuth": []
     }
    ],
    "summary": "Pomodoro statistics",
