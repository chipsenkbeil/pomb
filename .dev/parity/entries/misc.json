{"id":"settings-tables-fields-900","noGolden":"Pomb-only state with no KanbanFlow golden; regress mode compares it between builds.","viewport":{"width":900,"height":900},"note":"Board settings, Custom fields tab, with the field table.","setup":[{"goto":"/b/{gm}/settings/fields"},{"waitFor":"#field-table"}],"comparisons":[]},
{"id":"settings-tables-board-tokens-1280","noGolden":"Pomb-only state with no KanbanFlow golden; regress mode compares it between builds.","viewport":{"width":1280,"height":900},"note":"Board settings, API tab, with twelve personal tokens in the token table.","setup":[{"goto":"/b/{gm}/settings/api-webhooks"},{"eval":"(async()=>{for(let i=1;i<=12;i++){const r=await fetch('/api/v1/auth/tokens',{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},credentials:'same-origin',body:JSON.stringify({name:'settings-tables-'+String(i).padStart(2,'0'),preset:'read'})});if(!r.ok)throw new Error('seed '+r.status)}})()"},{"reload":1},{"waitFor":"#token-table .token-row"},{"eval":"(()=>{const b=document.querySelector('#token-table tbody');const rows=[...b.querySelectorAll('tr')];rows.sort((x,y)=>x.cells[0].textContent.localeCompare(y.cells[0].textContent));rows.forEach(r=>{const c=r.querySelector('td code');if(c)c.textContent='pomb_…0000';b.appendChild(r)})})()"}],"teardown":[{"eval":"(async()=>{const h={Accept:'application/json'};const l=await(await fetch('/api/v1/auth/tokens',{headers:h,credentials:'same-origin'})).json();for(const t of l){if(t.name.startsWith('settings-tables-')){const r=await fetch('/api/v1/auth/tokens/'+t.id,{method:'DELETE',headers:h,credentials:'same-origin'});if(!r.ok)throw new Error('revoke '+r.status)}}})()"}],"comparisons":[]},
