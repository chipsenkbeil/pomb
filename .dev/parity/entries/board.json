{"id":"board-09-boards-dropdown","golden":"board/09-boards-dropdown","viewport":{"width":1440,"height":612},
  "note":"The server lists boards in random-id order, so the setup sorts the rows by name to keep the state repeatable.",
 "setup":[{"goto":"/b/{gm}"},{"click":"#boards-dropdown-btn"},{"waitFor":"#boards-dropdown"},{"eval":"(() => { const ul = document.getElementById('bs-all'); [...ul.children].sort((a, b) => a.dataset.boardName.localeCompare(b.dataset.boardName)).forEach((li) => ul.appendChild(li)); })()"}],
 "comparisons":[
