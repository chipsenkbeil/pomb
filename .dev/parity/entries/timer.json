{"id":"timer-20-log","golden":"timer/20-timer-log-styles","viewport":{"width":1440,"height":612},"clock":"controlled",
 "note":"Timer log with one manual entry on Task Beta today. The golden dialog sits at x 385 because KanbanFlow's page had a 10 px scrollbar, so it centres 5 px left of where a Pomb dialog centres; the entry offset adds 5 to every expected x.",
 "offset":{"x":5},
 "setup":[{"goto":"/b/{vt}"},{"api":["POST","/api/time/manual",{"task_id":"{task:vt:Task Beta}","date":"2026-10-16","from":"17:43","to":"17:44"}]},{"click":"#timer-pill"},{"waitFor":"#timer-popup"},{"click":"#timer-popup .timer-foot-btn","nth":2},{"waitFor":"#timer-log-overlay .timer-log-modal"},{"wait":300}],
 "comparisons":[
  {"id":"dialog","key":"dialog","sel":".timer-log-modal","props":["x","y","w","h","bg","br"]},
  {"id":"toolbar","key":"toolbar","sel":".timer-log-filters","props":["x","y","w","h","bg"]},
  {"id":"boardFilter","key":"boardFilter","sel":"#log-board-filter","props":["x","y","w","h","bg","b","fs"]},
  {"id":"periodFilter","key":"periodFilter","sel":"#log-period-filter","props":["x","y","w","h","bg","b","fs"]},
  {"id":"toolbarIcon","key":"toolbarIcon","sel":"#log-print","props":["x","y","w","h","br"]},
  {"id":"dateGroup","key":"dateGroup","sel":".log-day-group","props":["x","w","bg","b","br"]},
  {"id":"dateTitle","key":"dateTitle","sel":".log-day-title","range":true,"props":["x","c","fs","text"]},
  {"id":"dateTotal","key":"dateTotal","sel":".log-day-total","range":true,"props":["c","fs"]},
  {"id":"item","key":"item","sel":".log-entry","nth":0,"props":["x","w"]},
  {"id":"taskColor","key":"taskColor","sel":".log-dot","nth":0,"props":["w","h","br"]},
  {"id":"title","key":"title","sel":".log-task","nth":0,"range":true,"props":["x","c","fs","fw"]},
  {"id":"timespan","key":"timespan","sel":".log-when","nth":0,"range":true,"props":["c","fs"]},
  {"id":"duration","key":"duration","sel":".log-dur","nth":0,"range":true,"props":["c","fs"]},
  {"id":"more","key":"more","sel":".log-more","nth":0,"props":["w","h","br","o"]}
 ]},

